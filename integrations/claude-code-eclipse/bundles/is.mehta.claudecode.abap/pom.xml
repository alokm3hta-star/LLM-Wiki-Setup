<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>is.mehta.claudecode</groupId>
    <artifactId>parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>is.mehta.claudecode.abap</artifactId>
  <packaging>eclipse-plugin</packaging>

  <build>
    <plugins>
      <!-- Vendor gson onto the Bundle-ClassPath (train-independent JSON) -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.7.1</version>
        <executions>
          <execution>
            <id>copy-gson</id>
            <phase>generate-resources</phase>
            <goals><goal>copy</goal></goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>com.google.code.gson</groupId>
                  <artifactId>gson</artifactId>
                  <version>2.11.0</version>
                  <destFileName>gson.jar</destFileName>
                </artifactItem>
              </artifactItems>
              <outputDirectory>${project.basedir}/lib</outputDirectory>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <!-- Build sidecar + UI with npm; skip with -DskipNpm=true -->
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.5.0</version>
        <executions>
          <execution>
            <id>npm-install-ui</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipNpm}</skip>
              <executable>npm</executable>
              <workingDirectory>${project.basedir}/ui-src</workingDirectory>
              <arguments><argument>install</argument><argument>--no-audit</argument><argument>--no-fund</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-build-ui</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipNpm}</skip>
              <executable>npm</executable>
              <workingDirectory>${project.basedir}/ui-src</workingDirectory>
              <arguments><argument>run</argument><argument>build</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-install-sidecar-src</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipNpm}</skip>
              <executable>npm</executable>
              <workingDirectory>${project.basedir}/sidecar-src</workingDirectory>
              <arguments><argument>install</argument><argument>--no-audit</argument><argument>--no-fund</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-build-sidecar</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipNpm}</skip>
              <executable>npm</executable>
              <workingDirectory>${project.basedir}/sidecar-src</workingDirectory>
              <arguments><argument>run</argument><argument>build</argument></arguments>
            </configuration>
          </execution>
          <execution>
            <id>npm-vendor-sidecar-runtime</id>
            <phase>generate-resources</phase>
            <goals><goal>exec</goal></goals>
            <configuration>
              <skip>${skipNpm}</skip>
              <executable>npm</executable>
              <workingDirectory>${project.basedir}/sidecar</workingDirectory>
              <arguments><argument>install</argument><argument>--omit=dev</argument><argument>--no-audit</argument><argument>--no-fund</argument></arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
