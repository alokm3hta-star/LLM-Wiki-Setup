<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>is.mehta.claudecode</groupId>
  <artifactId>parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Claude Code for ABAP (parent)</name>

  <properties>
    <tycho.version>4.0.13</tycho.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- -DskipNpm=true for Java-only rebuilds -->
    <skipNpm>false</skipNpm>
  </properties>

  <modules>
    <module>bundles/is.mehta.claudecode.abap</module>
    <module>features/is.mehta.claudecode.abap.feature</module>
    <module>releng/is.mehta.claudecode.abap.site</module>
  </modules>

  <repositories>
    <!-- Pinned release train matching the target Eclipse (Platform 4.40 / 2026-06) -->
    <repository>
      <id>eclipse-2026-06</id>
      <layout>p2</layout>
      <url>https://download.eclipse.org/releases/2026-06</url>
    </repository>
  </repositories>

  <build>
    <plugins>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>tycho-maven-plugin</artifactId>
        <version>${tycho.version}</version>
        <extensions>true</extensions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.tycho</groupId>
        <artifactId>target-platform-configuration</artifactId>
        <version>${tycho.version}</version>
        <configuration>
          <environments>
            <environment>
              <os>macosx</os>
              <ws>cocoa</ws>
              <arch>aarch64</arch>
            </environment>
          </environments>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
